{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run build && vitest run",
    "test:compliance": "vitest run --project compliance",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "typecheck": "bun run build && tsc --build",
    "size": "bun run build && bun run --cwd packages/collector size",
    "smoke": "bun run --cwd packages/collector smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@moqtap/codec": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "name": "",
  "version": ""
}
