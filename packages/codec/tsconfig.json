{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `tsc --build` typechecks and emits nothing. tsup owns `dist` -- it writes
    // the bundle, the .d.ts and the .cjs, and `clean: true` wipes the directory
    // first. An `outDir` here would put two tools on the same filenames, and
    // the tarball excludes `dist/*/`, so the surviving entry point would import
    // a subtree that is not in it.
    "noEmit": true,
    "composite": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
