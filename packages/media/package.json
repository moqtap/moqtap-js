{
  "name": "@moqtap/media",
  "version": "0.3.0",
  "description": "Media payloads carried over MoQT made readable: ISO BMFF and CMAF boxes, Annex-B H.264/H.265, MSF/CMSF catalogs and timelines, and LOC properties",
  "type": "module",
  "license": "MIT",
  "author": "moqtap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moqtap/moqtap-js.git",
    "directory": "packages/media"
  },
  "homepage": "https://github.com/moqtap/moqtap-js/tree/master/packages/media",
  "bugs": "https://github.com/moqtap/moqtap-js/issues",
  "keywords": [
    "moqt",
    "moq",
    "media-over-quic",
    "cmaf",
    "cmsf",
    "msf",
    "loc",
    "fmp4",
    "isobmff",
    "h264",
    "hevc"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bmff": {
      "bun": "./src/bmff.ts",
      "types": "./dist/bmff.d.ts",
      "import": "./dist/bmff.js",
      "require": "./dist/bmff.cjs"
    },
    "./annexb": {
      "bun": "./src/annexb.ts",
      "types": "./dist/annexb.d.ts",
      "import": "./dist/annexb.js",
      "require": "./dist/annexb.cjs"
    },
    "./catalog": {
      "bun": "./src/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "require": "./dist/catalog.cjs"
    },
    "./loc": {
      "bun": "./src/loc.ts",
      "types": "./dist/loc.d.ts",
      "import": "./dist/loc.js",
      "require": "./dist/loc.cjs"
    },
    "./cmaf": {
      "bun": "./src/cmaf.ts",
      "types": "./dist/cmaf.d.ts",
      "import": "./dist/cmaf.js",
      "require": "./dist/cmaf.cjs"
    },
    "./timeline": {
      "bun": "./src/timeline.ts",
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js",
      "require": "./dist/timeline.cjs"
    },
    "./frames": {
      "bun": "./src/frames.ts",
      "types": "./dist/frames.d.ts",
      "import": "./dist/frames.js",
      "require": "./dist/frames.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "devDependencies": {
    "@moqtap/test-vectors": "^0.21.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
